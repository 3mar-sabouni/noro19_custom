<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="before_after_page" name="Before &amp; After">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure pw2-page pw3-results-page">
                <section class="pw3-page-hero pw3-results-hero">
                    <div class="container text-center"><div class="row justify-content-center"><div class="col-lg-9 pw2-reveal"><span class="pw2-eyebrow">Before &amp; after</span><h1>Real stories, side by side.</h1><p>Explore treatment results by area and drag each comparison to reveal the change.</p></div></div></div>
                </section>
                <section class="pw2-section pw3-gallery-section">
                    <div class="container">
                        <div class="pw3-filter-bar pw2-reveal"><button type="button" class="is-active" data-pw3-filter="all">All</button><button type="button" data-pw3-filter="face">Face</button><button type="button" data-pw3-filter="neck">Neck</button><button type="button" data-pw3-filter="body">Body</button></div>
                        <div class="row g-4 pw3-results-grid">
                            <div class="col-lg-6 pw3-result-item" data-pw3-category="face"><article class="pw3-result-card pw2-reveal"><div class="pw2-before-after"><img class="pw2-ba-before" src="https://api.sofwave.com/app/uploads/2024/10/before-sofwave-face-treatment-4-by-roy-geronemus-md.jpg" alt="Before face"/><div class="pw2-ba-after-wrap"><img class="pw2-ba-after" src="https://api.sofwave.com/app/uploads/2024/10/after-12-weeks-sofwave-face-treatment-4-by-roy-geronemus-md.jpg" alt="After face"/></div><span class="pw2-ba-label pw2-ba-left">Before</span><span class="pw2-ba-label pw2-ba-right">After</span><div class="pw2-ba-divider"><span><i class="fa fa-arrows-h"/></span></div><input class="pw2-ba-range" type="range" min="0" max="100" value="50" aria-label="Face before and after"/></div><div class="pw3-result-meta"><span>Face</span><h3>Face treatment</h3><p>Reference result imagery · 12 week view.</p></div></article></div>
                            <div class="col-lg-6 pw3-result-item" data-pw3-category="neck"><article class="pw3-result-card pw2-reveal pw2-delay-1"><div class="pw2-before-after"><img class="pw2-ba-before" src="https://api.sofwave.com/app/uploads/2024/10/before-sofwave-neck-procedure-by-suzanne-kilmer.jpg" alt="Before neck"/><div class="pw2-ba-after-wrap"><img class="pw2-ba-after" src="https://api.sofwave.com/app/uploads/2024/10/after-12-weeks-sofwave-neck-procedure-by-suzanne-kilmer.jpg" alt="After neck"/></div><span class="pw2-ba-label pw2-ba-left">Before</span><span class="pw2-ba-label pw2-ba-right">After</span><div class="pw2-ba-divider"><span><i class="fa fa-arrows-h"/></span></div><input class="pw2-ba-range" type="range" min="0" max="100" value="50" aria-label="Neck before and after"/></div><div class="pw3-result-meta"><span>Neck</span><h3>Neck treatment</h3><p>Reference result imagery · 12 week view.</p></div></article></div>
                            <div class="col-lg-6 pw3-result-item" data-pw3-category="body"><article class="pw3-result-card pw2-reveal"><div class="pw2-before-after"><img class="pw2-ba-before" src="https://api.sofwave.com/app/uploads/2024/10/before-sofwave-cellulite-treatment-by-eric-bernstein-md.jpg" alt="Before body"/><div class="pw2-ba-after-wrap"><img class="pw2-ba-after" src="https://api.sofwave.com/app/uploads/2024/10/after-12-weeks-sofwave-cellulite-treatment-by-eric-bernstein-md.jpg" alt="After body"/></div><span class="pw2-ba-label pw2-ba-left">Before</span><span class="pw2-ba-label pw2-ba-right">After</span><div class="pw2-ba-divider"><span><i class="fa fa-arrows-h"/></span></div><input class="pw2-ba-range" type="range" min="0" max="100" value="50" aria-label="Body before and after"/></div><div class="pw3-result-meta"><span>Body</span><h3>Body treatment</h3><p>Reference result imagery · 12 week view.</p></div></article></div>
                            <div class="col-lg-6 pw3-result-item" data-pw3-category="face"><article class="pw3-result-card pw2-reveal pw2-delay-1"><div class="pw2-before-after"><img class="pw2-ba-before" src="https://api.sofwave.com/app/uploads/2024/10/before-sofwave-face-treatment-4-by-roy-geronemus-md.jpg" alt="Before face"/><div class="pw2-ba-after-wrap"><img class="pw2-ba-after" src="https://api.sofwave.com/app/uploads/2024/10/after-12-weeks-sofwave-face-treatment-4-by-roy-geronemus-md.jpg" alt="After face"/></div><span class="pw2-ba-label pw2-ba-left">Before</span><span class="pw2-ba-label pw2-ba-right">After</span><div class="pw2-ba-divider"><span><i class="fa fa-arrows-h"/></span></div><input class="pw2-ba-range" type="range" min="0" max="100" value="42" aria-label="Face before and after"/></div><div class="pw3-result-meta"><span>Face</span><h3>Facial rejuvenation</h3><p>Additional gallery layout ready for customer-approved result sets.</p></div></article></div>
                        </div>
                    </div>
                </section>
                <section class="pw3-results-note"><div class="container"><div class="row justify-content-center text-center"><div class="col-lg-8 pw2-reveal"><h2>Results vary from person to person.</h2><p>Use this section for clinical disclaimers, treatment timing and customer-approved result information.</p><a href="/find-a-provider" class="pw2-button pw2-button-light">Find a provider <i class="fa fa-arrow-right"/></a></div></div></div></section>
            </div>
        </t>
    </template>
</odoo>
