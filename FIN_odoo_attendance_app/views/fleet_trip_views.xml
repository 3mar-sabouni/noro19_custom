<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Tree View -->
    <record id="view_fleet_trip_tree" model="ir.ui.view">
        <field name="name">odoo.attendance.fleet.trip.list</field>
        <field name="model">odoo.attendance.fleet.trip</field>
        <field name="arch" type="xml">
            <list string="Trips">
                <field name="trip_start_date_time"/>
                <field name="driver_employee_app_id"/>
                <field name="driver_user_id" optional="hide"/>
                <field name="vehicle_id"/>
                <field name="analytic_account_id"/>
                <field name="start_google_maps_location"/>
                <field name="start_kilometrage"/>
                <field name="trip_end_date_time"/>
                <field name="end_kilometrage"/>
                <field name="end_google_maps_location"/>
                <field name="kilometrage_difference"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_fleet_trip_form" model="ir.ui.view">
        <field name="name">odoo.attendance.fleet.trip.form</field>
        <field name="model">odoo.attendance.fleet.trip</field>
        <field name="arch" type="xml">
            <form string="Fleet Trip">
                <header>
                    <button name="action_complete_trip" string="Complete Trip" type="object" class="btn-primary" modifiers="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <button name="action_cancel_trip" string="Cancel Trip" type="object" modifiers="{'invisible': [('state', '=', 'cancelled')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="driver_employee_app_id"/>
                            <field name="driver_user_id" optional="hide"/>
                            <field name="vehicle_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group>
                            <field name="trip_start_date_time"/>
                            <field name="trip_end_date_time"/>
                            <field name="kilometrage_difference"/>
                        </group>
                    </group>
                    <group string="km / mi / hr Tracking">
                        <group>
                            <field name="start_kilometrage"/>
                            <field name="end_kilometrage"/>
                        </group>
                    </group>
                    <group string="Location Information">
                        <group>
                            <field name="start_google_maps_location"/>
                        </group>
                        <group>
                            <field name="end_google_maps_location"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fleet_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">odoo.attendance.fleet.trip</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first fleet trip
            </p>
            <p>
                Fleet trips track vehicle usage, km / mi / hr, and locations for comprehensive fleet management.
            </p>
        </field>
    </record>

    <record id="action_fleet_dashboard" model="ir.actions.client">
        <field name="name">Fleet Dashboard</field>
        <field name="tag">odoo_attendance_app.fleet_dashboard</field>
        <field name="target">current</field>
    </record>
</odoo>


