<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_odoo_attendance_inbox_message_list" model="ir.ui.view">
        <field name="name">odoo.attendance.inbox.message.list</field>
        <field name="model">odoo.attendance.inbox.message</field>
        <field name="arch" type="xml">
            <list string="Mobile App Messages" delete="1">
                <field name="name"/>
                <field name="message_type"/>
                <field name="repeat_enabled"/>
                <field name="recipient_mode"/>
                <field name="scheduled_at_local" string="Scheduled"/>
                <field name="sent_at_local" string="Sent"/>
                <field name="recipient_count" string="Recipients"/>
                <field name="read_count" string="Read"/>
                <field name="unread_count" string="Unread"/>
            </list>
        </field>
    </record>

    <record id="view_odoo_attendance_inbox_message_form" model="ir.ui.view">
        <field name="name">odoo.attendance.inbox.message.form</field>
        <field name="model">odoo.attendance.inbox.message</field>
        <field name="arch" type="xml">
            <form string="Mobile App Message" delete="1">
                <header>
                    <button name="action_send_now" type="object" string="Send Now" class="oe_highlight"
                            invisible="sent_at"/>
                    <button name="action_open_repeat_group" type="object" string="Repeat History"
                            invisible="not repeat_group_id"/>
                    <button name="action_stop_repeat" type="object" string="Stop Repeat"
                            invisible="not repeat_enabled"/>
                </header>
                <sheet>
                    <!-- keep backend control fields in the form so onchange/inverse values are saved -->
                    <field name="repeat_enabled" invisible="1"/>
                    <group>
                        <field name="name"/>
                        <field name="message_type"/>
                    </group>
                    <group>
                        <field name="send_mode"/>
                        <field name="scheduled_at" options="{'minuteIncrement': 1}"
                               invisible="send_mode == 'send_now'"
                               readonly="send_mode == 'repeat'"/>
                        <field name="scheduled_at_local" readonly="1"
                               invisible="not scheduled_at"/>
                        <field name="sent_at" readonly="1"/>
                        <field name="sent_at_local" readonly="1"
                               invisible="not sent_at"/>
                    </group>
                    <group string="Repeat">
                        <field name="repeat_time_hhmm" invisible="send_mode != 'repeat'" placeholder="HH:MM"/>
                        <field name="repeat_mon" invisible="send_mode != 'repeat'"/>
                        <field name="repeat_tue" invisible="send_mode != 'repeat'"/>
                        <field name="repeat_wed" invisible="send_mode != 'repeat'"/>
                        <field name="repeat_thu" invisible="send_mode != 'repeat'"/>
                        <field name="repeat_fri" invisible="send_mode != 'repeat'"/>
                        <field name="repeat_sat" invisible="send_mode != 'repeat'"/>
                        <field name="repeat_sun" invisible="send_mode != 'repeat'"/>
                    </group>
                    <group>
                        <field name="repeat_group_id" readonly="1" invisible="not repeat_group_id"/>
                        <field name="repeat_group_count" readonly="1" invisible="not repeat_group_id"/>
                    </group>
                    <group>
                        <field name="recipient_mode"/>
                        <field name="target_all" invisible="1"/>
                        <field name="target_employee_app_ids" widget="many2many_tags"
                               invisible="recipient_mode != 'selected'"/>
                    </group>
                    <group>
                        <field name="body" nolabel="1" placeholder="Write your message here..."/>
                    </group>
                    <separator string="Delivery"/>
                    <group>
                        <field name="recipient_count" readonly="1"/>
                        <field name="read_count" readonly="1"/>
                        <field name="unread_count" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Recipients">
                            <field name="recipient_ids" readonly="1">
                                <list>
                                    <field name="employee_app_id"/>
                                    <field name="delivered_at"/>
                                    <field name="is_read"/>
                                    <field name="read_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_attendance_inbox_messages" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">odoo.attendance.inbox.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Send announcements and scheduled messages to mobile app employees.
            </p>
        </field>
    </record>

</odoo>
