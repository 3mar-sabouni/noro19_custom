<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ir_attachment_download_selected_zip" model="ir.actions.server">
        <field name="name">Download Selected as ZIP</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="binding_model_id" ref="base.model_ir_attachment"/>
        <field name="binding_view_types">list,tree</field>
        <field name="state">code</field>
        <field name="code">action = records.action_download_selected_zip()</field>
    </record>

    <record id="action_ir_attachment_delete_selected" model="ir.actions.server">
        <field name="name">Delete Selected Attachments</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="binding_model_id" ref="base.model_ir_attachment"/>
        <field name="binding_view_types">list,tree</field>
        <field name="state">code</field>
        <field name="code">action = records.action_delete_selected()</field>
    </record>
</odoo>


