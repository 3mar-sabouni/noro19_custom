<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- List View for Employee App Users -->
    <record id="view_odoo_attendance_employee_list" model="ir.ui.view">
        <field name="name">odoo.attendance.employee.list</field>
        <field name="model">odoo.attendance.employee</field>
        <field name="arch" type="xml">
            <list string="Mobile App Employees" delete="1">
                <field name="username"/>
                <field name="employee_id"/>
                <field name="is_driver"/>
                <field name="manager_employee_ids" widget="many2many_tags"/>
                <field name="selfie_policy_checkin"/>
                <field name="selfie_policy_checkout"/>
                <field name="geofence_policy"/>
                <field name="device_id"/>
                <field name="is_active"/>
                <field name="last_login"/>
            </list>
        </field>
    </record>

    <!-- Form View for Employee App Users -->
    <record id="view_odoo_attendance_employee_form" model="ir.ui.view">
        <field name="name">odoo.attendance.employee.form</field>
        <field name="model">odoo.attendance.employee</field>
        <field name="arch" type="xml">
            <form string="Mobile App Employee" delete="1">
                <header>
                    <button name="reset_device_binding" string="Reset Device Binding" 
                            type="object" class="oe_highlight"
                            confirm="This will unbind the device and invalidate all sessions. The employee will need to login again. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="is_active" widget="boolean_button" 
                                   options="{'terminology': 'active'}"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="username"/>
                            <field name="employee_id"/>
                            <field name="manager_employee_ids" widget="many2many_tags"/>
                            <field name="selfie_policy_checkin"/>
                            <field name="selfie_policy_checkout"/>
                            <field name="geofence_policy"/>
                            <field name="can_check_attendance_for_others"/>
                            <field name="allowed_attendance_user_ids"
                                   widget="many2many_tags"
                                   domain="[('id', '!=', id)]"
                                   invisible="not can_check_attendance_for_others"/>
                            <field name="geofence_location_ids">
                                <list editable="bottom">
                                    <field name="name" string="Location Name"/>
                                    <field name="latitude" string="Latitude"/>
                                    <field name="longitude" string="Longitude"/>
                                    <field name="radius_km" string="Allowed Radius (km)"/>
                                </list>
                            </field>
                            <field name="device_id" readonly="1"/>
                            <field name="fcm_token" readonly="1"/>
                            <field name="fcm_token_updated_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="is_driver"/>
                            <field name="is_active"/>
                            <field name="last_login" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sessions">
                            <field name="session_ids"/>
                        </page>
                        <page string="Security">
                            <group>
                                <field name="password"
                                       password="True"
                                       placeholder="Enter new password"/>
                                <field name="password_hash" invisible="1"/>
                            </group>
                            <separator string="Password Instructions"/>
                            <div class="text-muted ms-2">
                                Enter a password above to set or reset the employee's mobile app password.
                                Leave blank to keep the current password.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_odoo_attendance_employee_search" model="ir.ui.view">
        <field name="name">odoo.attendance.employee.search</field>
        <field name="model">odoo.attendance.employee</field>
        <field name="arch" type="xml">
            <search string="Search Mobile App Employees">
                <field name="username"/>
                <field name="employee_id"/>
                <field name="is_driver"/>
                <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('is_active', '=', False)]"/>
                <filter string="Device Bound" name="device_bound" domain="[('device_id', '!=', False)]"/>
                <filter string="No Device" name="no_device" domain="[('device_id', '=', False)]"/>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_odoo_attendance_employee" model="ir.actions.act_window">
        <field name="name">Mobile App Employees</field>
        <field name="res_model">odoo.attendance.employee</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a mobile app employee account
            </p>
            <p>
                Create employee accounts for the Odoo Attendance mobile app.
                Each account is linked to an HR employee and uses app-specific credentials.
            </p>
        </field>
    </record>
    
</odoo>
