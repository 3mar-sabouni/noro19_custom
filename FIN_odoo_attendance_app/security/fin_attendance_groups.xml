<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_fin_attendance" model="ir.module.category">
            <field name="name">FIN Attendance</field>
            <field name="description">Access rights for FIN Attendance module.</field>
            <field name="parent_id" ref="base.module_category_human_resources"/>
            <field name="sequence">35</field>
        </record>

        <record id="privilege_fin_attendance" model="res.groups.privilege">
            <field name="name">FIN Attendance</field>
        </record>

        <record id="group_fin_attendance_user" model="res.groups">
            <field name="name">User</field>
            <field name="comment">Can use FIN Attendance features allowed for regular users.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="privilege_fin_attendance"/>
        </record>

        <record id="group_fin_attendance_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="comment">Can manage FIN Attendance settings, employees, and sessions.</field>
            <field name="privilege_id" ref="privilege_fin_attendance"/>
        </record>
    </data>
</odoo>
