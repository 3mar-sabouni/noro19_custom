<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_prescription">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page"
                         style="font-family: 'Helvetica', 'Arial', sans-serif;
                                font-size: 13px;
                                color: #000;">

                        <!-- HEADER -->
                        <div style="border: 2px solid #000; padding: 12px;">
                            <div class="text-center">
                                <h1 style="margin:0; letter-spacing:2px; font-weight:800;">
                                     PRESCRIPTION
                                </h1>
                                <div style="margin-top:4px; font-size:12px;">
                                    Professional Medical Care
                                </div>
                            </div>
                        </div>

                        <!-- INFO BLOCK -->
                        <table style="width:100%; border-collapse: collapse; margin-top:10px;"
                               border="1">
                            <tr style="background:#f7f7f7;">
                                <td style="padding:6px;">
                                    <strong>Prescription No</strong><br/>
                                    <span t-esc="doc.sequence_no"/>
                                </td>
                                <td style="padding:6px;">
                                    <strong>Date</strong><br/>
                                    <span t-esc="doc.prescription_date"/>
                                </td>
                                <td style="padding:6px;">
                                    <strong>Appointment No</strong><br/>
                                    <span t-esc="doc.appointment_id.appointment_no"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:6px;">
                                    <strong>Patient Name</strong><br/>
                                    <span t-esc="doc.patient_id.name"/>
                                </td>
                                <td style="padding:6px;">
                                    <strong>Patient ID</strong><br/>
                                    <span t-esc="doc.patient_id.patient_no"/>
                                </td>
                                <td style="padding:6px;">
                                    <strong>Doctor</strong><br/>
                                    <span t-esc="doc.prescribed_doctor_id.name"/>
                                </td>
                            </tr>
                            <tr style="background:#f7f7f7;">
                                <td style="padding:6px;">
                                    <strong>Treatment</strong><br/>
                                    <span t-esc="doc.treatment_id.name"/>
                                </td>
                            
                            </tr>
                        </table>

                        <!-- RX -->
                        <div style="margin-top: 18px;">
                            <span style="font-size: 28px; font-weight: 700;">℞</span>
                        </div>

                        <!-- MEDICINE TABLE -->
                        <table style="width:100%;
                                      border-collapse: collapse;
                                      margin-top:6px;"
                               border="1">
                            <thead style="background:#e1e1e1;">
                                <tr>
                                    <th style="padding:6px;">Medicine</th>
                                    <th style="padding:6px;">Generic</th>
                                    <th style="padding:6px;">Dosage</th>
                                    <th style="padding:6px;">Form</th>
                                    <th style="padding:6px;">Qty</th>
                                    <th style="padding:6px;">Take</th>
                                    <th style="padding:6px;">M</th>
                                    <th style="padding:6px;">A</th>
                                    <th style="padding:6px;">N</th>
                                    <th style="padding:6px;">Days</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.medicine_ids" t-as="med">
                                    <tr>
                                        <td style="padding:6px;">
                                            <strong t-esc="med.medicament_id.name"/>
                                        </td>
                                        <td style="padding:6px;">
                                            <span t-esc="med.generic_name"/>
                                        </td>
                                        <td style="padding:6px;">
                                            <span t-esc="med.dosage_strength"/>
                                        </td>
                                        <td style="padding:6px;">
                                            <span t-esc="med.medicament_form"/>
                                        </td>
                                        <td style="padding:6px; text-align:center;">
                                            <span t-esc="med.quantity"/>
                                        </td>
                                        <td style="padding:6px; text-align:center;">
                                            <span t-esc="med.medicine_take"/>
                                        </td>
                                        <td style="padding:6px; text-align:center;">
                                            <span t-esc="'✔' if med.morning else '-'"/>
                                        </td>
                                        <td style="padding:6px; text-align:center;">
                                            <span t-esc="'✔' if med.noon else '-'"/>
                                        </td>
                                        <td style="padding:6px; text-align:center;">
                                            <span t-esc="'✔' if med.night else '-'"/>
                                        </td>
                                        <td style="padding:6px; text-align:center;">
                                            <span t-esc="med.days"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- FOOTER -->
                        <div style="margin-top: 20px; border-top: 2px solid #000; padding-top:10px;">
                            <table style="width:100%;">
                                <tr>
                                    <td width="60%">
                                        <strong>Doctor’s Instructions:</strong><br/>
                                        Please follow dosage carefully and complete the full course.
                                    </td>
                                    <td width="40%" style="text-align:right;">
                                        <strong>Doctor Signature</strong><br/><br/>
                                        _______________________<br/>
                                        <span t-esc="doc.prescribed_doctor_id.name"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
