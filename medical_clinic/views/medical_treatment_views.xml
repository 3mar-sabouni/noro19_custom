<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  Tree View-->
    <record id="medical_treatment_view_tree" model="ir.ui.view">
            <field name="name">medical.treatment.view.tree</field>
            <field name="model">medical.treatment</field>
            <field name="arch" type="xml">
                <list string="Medical Treatment" editable="bottom">
                    <field name="name" required="True"/>
                    <field name="treatment_categ_id" required="True"/>
                    <field name="cost"/>
                </list>
            </field>
    </record>
        <record id="medical_treatment_menu_action" model="ir.actions.act_window">
        <field name="name">Medical Treatment</field>
        <field name="res_model">medical.treatment</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="hospital_root_menu" name="Medical Clinic" sequence="1"/>
    <menuitem id="medical_configure" name="Configure" parent="hospital_root_menu" sequence="5"/>
    <menuitem id="medical_treatment_menu" name="Treatments" parent="medical_configure" sequence="10"
              action="medical_treatment_menu_action"/>


</odoo>
