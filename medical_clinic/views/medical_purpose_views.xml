<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_Treatment_type_appointment_form" model="ir.ui.view">
            <field name="name">medical.purpose.form</field>
            <field name="model">medical.purpose</field>
            <field name="arch" type="xml">
               <form string="Medical Treatment">
                   <sheet><group>
                   <field name="name"/></group>
                   </sheet>
               </form>
            </field>
        </record>
        <record id="view_Treatment_type_appointment_tree" model="ir.ui.view">
            <field name="name">medical.purpose.tree</field>
            <field name="model">medical.purpose</field>
            <field name="arch" type="xml">
               <list string="Medical Treatment">
                       <field name="name"/>
               </list>
            </field>
        </record>
         <!-- WINDOW ACTION -->
        <record id="medical_purpose_menu_action" model="ir.actions.act_window">
            <field name="name">Purpose</field>
            <field name="res_model">medical.purpose</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- MENU STRUCTURE -->
        <menuitem id="hospital_root_menu" name="Medical Clinic" sequence="1"/>
        <menuitem id="medical_configure" name="Configure" parent="hospital_root_menu"  sequence="5"/>
        <menuitem id="medical_purpose" name="purpose" parent="medical_configure" action="medical_purpose_menu_action" sequence="1"/>
    </data>
</odoo>
