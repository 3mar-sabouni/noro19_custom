<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  Tree View-->
    <record id="medical_time_shift_view_tree" model="ir.ui.view">
        <field name="name">medical.time.shift.view.tree</field>
        <field name="model">medical.time.shift</field>
        <field name="arch" type="xml">
            <list string="Medical Time Shift">
                <field name="name"/>
                <field name="shift_type"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
            </list>
        </field>
    </record>
    <!--  Form View-->
    <record id="medical_time_shift_view_form" model="ir.ui.view">
        <field name="name">medical.time.shift.view.form</field>
        <field name="model">medical.time.shift</field>
        <field name="arch" type="xml">
            <form string="Medical Time Shift">
                <sheet>
                    <h1>
                        <div class="d-flex">
                            <field name="name" force_save="1"/>
                        </div>
                    </h1>
                    <group>
                        <group>
                            <field name="shift_type"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="medical_time_shift_menu_action" model="ir.actions.act_window">
        <field name="name">Medical Time Shift</field>
        <field name="res_model">medical.time.shift</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hospital_root_menu" name="Medical Clinic" sequence="1"/>
    <menuitem id="medical_configure" name="Configure" parent="hospital_root_menu" sequence="5"/>
    <menuitem id="Shift_time_menu" name="Clinic Shift Time" parent="medical_configure" sequence="2"
              action="medical_time_shift_menu_action"/>
</odoo>
