<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="seq_medical_patient" model="ir.sequence">
        <field name="name">Medical Patient Sequence</field>
        <field name="code">medical.patient</field>
        <field name="prefix">PT</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

     <record id="seq_medical_appointment" model="ir.sequence">
        <field name="name">Appointment Number</field>
        <field name="code">medical.appointment</field>
        <field name="prefix">APT/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_medical_prescription" model="ir.sequence">
        <field name="name">Medical Prescription</field>
        <field name="code">medical.prescriptions</field>
        <field name="prefix">PRN</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
